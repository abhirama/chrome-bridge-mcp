{
  "manifest_version": 3,
  "name": "Chrome Bridge for MCP",
  "version": "0.1.0",
  "description": "Lets a local MCP server drive this Chrome profile \u2014 your real tabs, cookies and logged-in sessions \u2014 over the Chrome DevTools Protocol.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "storage",
    "alarms",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Chrome Bridge for MCP",
    "default_popup": "popup.html"
  }
}
